{
  "name": "@{{ .ProjectSlug }}/shared",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "dependencies": {
{{- if eq .Database "mysql" }}
    "mysql2": "^3.9.0",
    "typeorm": "^0.3.19",
{{- else if eq .Database "postgres" }}
    "pg": "^8.11.0",
    "typeorm": "^0.3.19",
{{- else }}
    "mongodb": "^6.3.0",
{{- end }}
    "dotenv": "^16.4.0",
    "ioredis": "^5.3.2",
    "morgan": "^1.10.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"{{- if eq .Auth "jwt" }},
    "jsonwebtoken": "^9.0.2"{{- else }},
    "@panva/paseto": "^3.1.0"{{- end }}
  }
}
